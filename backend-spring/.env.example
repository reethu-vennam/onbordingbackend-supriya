# Database
DB_URL=jdbc:mariadb://localhost:3306/sabbpe
DB_USERNAME=sabbpe
DB_PASSWORD=sabbpe

# JWT
JWT_SECRET=base64-encoded-secret-at-least-256-bits-long

# CORS: only needed for local dev (no Apache in front). Set CORS_ENABLED=false in the real
# Apache-fronted deployment, where Apache adds these headers instead.
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:8877,http://localhost:5173,http://localhost:3000

# Server (fixed at 8080 in application.yml — not env-configurable)
# Set to 'prod' in production deployments (application-prod.yml is NOT activated by default)
SPRING_PROFILES_ACTIVE=dev

# Email (Zoho SMTP)
EMAIL_HOST=smtppro.zoho.in
EMAIL_PORT=465
EMAIL_USER=payments@sabbpe.com
EMAIL_PASS=
EMAIL_SECURE=true
EMAIL_FROM=payments@sabbpe.com

# Notification recipients
ADMIN_EMAIL=payments@sabbpe.com
NOTIFICATION_FROM_EMAIL=payments@sabbpe.com
NOTIFICATION_ONBOARDING_TEAM_EMAIL=vendor.onboarding@sabbpe.com
FRONTEND_URL=http://localhost:5173

# MSG91 (SMS/WhatsApp)
MSG91_AUTHKEY=
MSG91_WHATSAPP_URL=https://api.msg91.com/api/v5/whatsapp/whatsapp-outbound-message/bulk/
MSG91_INTEGRATED_NUMBER=
MSG91_TEMPLATE_NAME=ekyc_verification
MSG91_NAMESPACE=
MSG91_SMS_FLOW_URL=
MSG91_SMS_TEMPLATE_ID=
MSG91_INVITE_TEMPLATE=
MSG91_INVITE_NAMESPACE=

# Demo/verification endpoint access key (must match frontend VITE_DEMO_ACCESS_KEY)
DEMO_ACCESS_KEY=

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50MB

# Webhooks
WEBHOOK_SECRET=
WEBHOOK_API_KEY=

# Transbank
TRANSBANK_BASE_URL=https://transbank.sabbpe.com/api
TRANSBANK_CLIENT_ID=
TRANSBANK_ENTITY_ID=
TRANSBANK_PROGRAM_ID=513
TRANSBANK_PROCESSOR=TRANSBANK
TRANSBANK_TRANSACTION_TYPE=IMPS

# SabbPe ecosystem (Onboarding Team's 5 APIs — merchant onboard, token, mandate,
# subscription). secret_key and the NACH_MANDATE service credentials are issued
# out-of-band by that team; never put them in frontend code or commit real values.
SABBPE_ECOSYSTEM_BASE_URL=https://ecosystemuat.sabbpe.com
SABBPE_ECOSYSTEM_SECRET_KEY=
SABBPE_ORG_CODE_PREFIX=MERCH
SABBPE_NACH_USERID=
SABBPE_NACH_PASSWORD=
SABBPE_NACH_MERCHANTID=
SABBPE_UPI_REGISTER_CALLBACK_URL=https://ecosystemuat.sabbpe.com/api/v1/upimandate/cams/register/callback
SABBPE_UPI_DEBIT_URL=https://ecosystemuat.sabbpe.com/api/v1/upimandate/cams/execute/callback
# Shared secret for verifying X-Sabbpe-Signature on their POST /api/mandates/status-callback
# webhook. Leave blank until they issue one — signature check is skipped when blank.
# (Real value now baked into application.yml as the default — shared with mandate team 2026-09-23.)
SABBPE_ECOSYSTEM_WEBHOOK_SECRET=

# Settlement
SETTLEMENT_DRY_RUN=false
SETTLEMENT_MDR_PERCENTAGE=1.80
SETTLEMENT_RESERVE_RELEASE_DAYS=15

# Logging
LOG_LEVEL=INFO
